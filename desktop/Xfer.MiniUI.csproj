<Project Sdk="Microsoft.NET.Sdk">
  <!-- Xfer for Linux: the bundled MiniUI engine and GTK3/X11 layer showing ../ui with
       Xfer's native component (../native) in the same process. Built by tools/linux/build.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Xfer</AssemblyName>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))=/_/Xfer</PathMap>
    <StartupObject>Xfer.MiniUIHost</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416;CS8632;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;SYSLIB0050</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MiniUI.Core"><HintPath>../runtime/linux-x64/MiniUI.Core.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="MiniUI.Platform.Linux"><HintPath>../runtime/linux-x64/MiniUI.Platform.Linux.dll</HintPath><Private>true</Private></Reference>
    <Compile Include="../src/**/*.cs" />
    <Compile Include="../native/*.cs;../native/Linux/*.cs" />
    <Compile Include="*.cs" />
    <Reference Include="zxing"><HintPath>../lib/zxing.dll</HintPath><Private>true</Private></Reference>
    <EmbeddedResource Include="../web/*" LogicalName="Xfer.Web.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../ui/fonts/Inter-*.ttf" LogicalName="Xfer.Fonts.%(Filename)%(Extension)" />
    <None Include="../runtime/linux-x64/MINIUI_SOURCE_REVISION" Link="MINIUI_SOURCE_REVISION" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../runtime/MiniUI-THIRD-PARTY-NOTICES.md" Link="licenses/MiniUI-THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckMiniUI" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../runtime/linux-x64/MiniUI.Core.dll') Or !Exists('$(MSBuildThisFileDirectory)../runtime/linux-x64/MiniUI.Platform.Linux.dll')" Text="The bundled MiniUI DLLs are missing from runtime/linux-x64. Restore them from the Xfer distribution." />
  </Target>
</Project>
