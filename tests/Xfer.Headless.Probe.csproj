<Project Sdk="Microsoft.NET.Sdk">
  <!-- Same optical/camera product classes; no MiniUI sources, window or physical camera. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><Nullable>enable</Nullable>
    <StartupObject>Xfer.Probe.NativeLoopbackProbe</StartupObject>
    <NoWarn>$(NoWarn);CA1416;CS8632;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/**/*.cs" />
    <Compile Include="../native/CameraReceiver.cs;../native/QrStream.cs;../native/Fx2Stream.cs;../native/NativeBitmap.cs" />
    <Reference Include="zxing"><HintPath>../lib/zxing.dll</HintPath><Private>true</Private></Reference>
    <Compile Include="NativeLoopbackProbe.cs" />
  </ItemGroup>
</Project>
